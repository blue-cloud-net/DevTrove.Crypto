<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>DevTrove.Crypto.Core</PackageId>
        <IsPackable>true</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>BouncyCastle 封装：算法原语、密钥、ASN.1、X.509、CSR、PKCS#7/#12、CRL、OCSP 的解析与生成。</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" />
        <!-- SourceLink：nuget.md §4 推荐启用，使符号包直链 GitHub 源码 -->
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    </ItemGroup>

    <!-- 为 .NET Standard 2.0/2.1 添加所需的包 -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'netstandard2.1'">
        <PackageReference Include="System.ComponentModel.Annotations"/>
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
