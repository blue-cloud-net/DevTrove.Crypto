<!--
    仓库级 MSBuild 基线配置（Directory.Build.props）。
    每个 PropertyGroup/PropertySet 顶部以分类注释标注职责，便于
    review 与维护；分类键见 standards.md §2.3。
  -->
<Project>

  <!-- ========== [语言与代码风格] ========== -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevTrove.Crypto</RootNamespace>

    <!-- [构建基线] 警告即错误 + 构建期强制代码风格（standards.md §2.3） -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- ========== [NuGet 元数据] ==========
       库仓统一基线；子项目按需覆盖。 -->
  <PropertyGroup>
    <Authors>huansky</Authors>
    <Copyright>Copyright © blue-cloud-net 2026</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/blue-cloud-net/DevTrove.Crypto</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/blue-cloud-net/DevTrove.Crypto</PackageProjectUrl>
    <PackageTags>crypto;x509;certificate;asn1;pem;pkcs12;crl;csr;sm2;sm3;sm4;gm;bouncycastle</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <Version>0.0.1-dev</Version>
  </PropertyGroup>

  <!-- ========== [SourceLink 与符号包] ==========
       调试符号直链 GitHub 源码；snupkg 符号包发布到 NuGet。 -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>

  <!-- ========== [TFM 策略] ==========
       5 TFM：核心库最大化 NuGet 兼容面；应用项目 TFM 由子项目覆盖。 -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- ========== [AOT / 裁剪兼容] ==========
       net8.0+ 目标声明裁剪 / AOT 兼容；netstandard 目标不承载
       AOT 元数据（它们承担兼容面）。新增枚举显示名解析时需使用
       IsDynamicCodeSupported 守卫，避免反射路径在 AOT 下丢失显示名。 -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimmed>true</EnableTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

</Project>
